# Miso — Instagram Saved Reels → Notion Recipe Extractor

# Notion integration token (starts with ntn_ or secret_)
NOTION_API_TOKEN=

# The Recipes database ID (NOT a parent page — the DB itself)
# Live value: 90f96515-c3a3-4173-b317-35bff393082e
NOTION_PARENT_PAGE_ID=

# LLM API keys
GEMINI_API_KEY=          # tier-0: gemini-2.5-flash
ANTHROPIC_API_KEY=       # tier-2 escalation: claude-sonnet

# Optional tuning
# CONCURRENCY_EXTRACT=4  # default: 4 (Gemini extract + Notion write pool)
# CONCURRENCY_WRITE=3    # default: 3 (Notion write ceiling ~3 req/s)
# ESCALATION_CAP=1       # default: 1 (max enrichment climbs per reel)
# DRY_RUN=false          # default: false (set to true to skip Notion writes)
