# Miso — Instagram Saved Reels → Notion Recipe Extractor

# ── Notion ─────────────────────────────────────────────────────────────────
# The Recipes database ID (confirmed: same value as NOTION_PARENT_PAGE_ID)
NOTION_DATABASE_ID=90f96515c3a34173b31735bff393082e
# Data source ID (for dedup queries — same DB, inner data source)
NOTION_DATA_SOURCE_ID=2dd1b4f7bb934ecc8a34ee501fad3531
# Integration token (starts with ntn_)
NOTION_API_TOKEN=

# ── Nous Portal ────────────────────────────────────────────────────────────
# One key covers both tiers:
#   Tier-0  → google/gemini-3-flash-preview  (fast, cheap, caption-only)
#   Tier-2  → anthropic/claude-sonnet-4.6    (escalation, richer context)
#
# Get your key from: https://portal.nousresearch.com → Account → API Keys
NOUS_API_KEY=

# ── Optional tuning ────────────────────────────────────────────────────────
# CONCURRENCY_EXTRACT=4   default: 4  (extract + Notion write pool)
# CONCURRENCY_WRITE=3     default: 3  (Notion write ceiling ~3 req/s)
# ESCALATION_CAP=1        default: 1  (max enrichment climbs per reel)
# DRY_RUN=false           default: false (set true to skip Notion writes)
# CENSUS_ONLY=false        default: false (set true to classify only)
